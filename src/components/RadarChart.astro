---
// ラグドール vs 平均的な猫の六角レーダーチャート(ジョーク仕立て:ラグドールは枠を突き破る)
const AXES = [
  { k: 'かわいさ', amesho: 9.2, note: '測定不能' },
  { k: 'おだやかさ', amesho: 7.2 },
  { k: 'もふもふ度', amesho: 7.8 },
  { k: '抱っこ好き', amesho: 6.2 },
  { k: '瞳の美しさ', amesho: 7.4 },
  { k: '甘え上手', amesho: 6.8 },
];
const AVG = 3; // 平均的な猫(5段階中3)
const U = 22; // 1段階あたりの半径
const pt = (i: number, v: number) => {
  const a = -Math.PI / 2 + (i * Math.PI * 2) / AXES.length;
  return [Math.cos(a) * v * U, Math.sin(a) * v * U] as const;
};
const poly = (vals: number[]) => vals.map((v, i) => pt(i, v).map((n) => n.toFixed(1)).join(',')).join(' ');
const rings = [1, 2, 3, 4, 5];
---
<figure class="radar sketch">
  <svg viewBox="-250 -228 500 430" role="img" aria-label="ラグドールと平均的な猫のレーダーチャート。ラグドールはすべての項目で平均を大きく上回り、かわいさは測定不能">
    <g class="grid">
      {rings.map((r) => <polygon points={poly(AXES.map(() => r))} />)}
      {AXES.map((_, i) => { const [x, y] = pt(i, 5); return <line x1="0" y1="0" x2={x} y2={y} />; })}
    </g>
    <polygon class="avg" points={poly(AXES.map(() => AVG))} />
    <polygon class="amesho" points={poly(AXES.map((a) => a.amesho))} />
    {AXES.map((a, i) => { const [x, y] = pt(i, a.amesho); return <circle class="dot" cx={x} cy={y} r="5" style={`--x:${x.toFixed(1)}px;--y:${y.toFixed(1)}px`} />; })}
    {AXES.map((a, i) => {
      const [x, y] = pt(i, 6.6);
      return (
        <g class="label" transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
          <rect x="-50" y="-15" width="100" height="30" rx="15" />
          <text y="5" text-anchor="middle">{a.k}</text>
        </g>
      );
    })}
    <g transform={`translate(${pt(0, 9.2)[0] + 58} ${pt(0, 9.2)[1] + 6})`} class="boom">
      <text text-anchor="middle">測定不能!!</text>
    </g>
  </svg>
  <figcaption>
    <span class="key"><i class="k-amesho"></i>ラグドール</span>
    <span class="key"><i class="k-avg"></i>平均的な猫</span>
    <small>※当サイト調べ(独断)。どの猫もそれぞれ世界一かわいいのですが、ラグドールはグラフに収まりませんでした。</small>
  </figcaption>
</figure>

<style>
  .radar { margin: 22px 0 0; padding: 16px 16px 14px; background: #fff; }
  .radar svg { width: 100%; max-width: 520px; height: auto; margin: 0 auto; overflow: visible; }
  .grid polygon { fill: none; stroke: #e2d9d1; stroke-width: 1.5; }
  .grid polygon:last-of-type { stroke: var(--ink); stroke-width: 2.5; }
  .grid line { stroke: #e2d9d1; stroke-width: 1.5; }
  .avg { fill: rgba(154, 163, 168, .25); stroke: #9aa3a8; stroke-width: 2.5; stroke-dasharray: 6 5; }
  .amesho { fill: rgba(224, 123, 143, .28); stroke: var(--pink-deep); stroke-width: 3.5; stroke-linejoin: round; }
  .dot { fill: var(--pink-deep); stroke: #fff; stroke-width: 2; }
  .label rect { fill: #fff; stroke: var(--ink); stroke-width: 2; }
  .label text { font: 700 15px var(--font-body); fill: var(--ink); }
  .boom text { font: 400 17px var(--font-display); fill: var(--pink-deep); }
  figcaption { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; font-size: .86rem; font-weight: 700; margin-top: 6px; }
  figcaption small { flex-basis: 100%; text-align: center; font-weight: 500; color: var(--ink-soft); font-size: .78rem; }
  .key { display: inline-flex; align-items: center; gap: 6px; }
  .key i { width: 22px; height: 12px; border-radius: 4px; display: inline-block; }
  .k-amesho { background: rgba(224, 123, 143, .5); border: 2px solid var(--pink-deep); }
  .k-avg { background: rgba(154, 163, 168, .35); border: 2px dashed #9aa3a8; }
  /* スクロールで見えた瞬間に伸びる(JSが動かない環境では最初から完成形を表示) */
  @media (prefers-reduced-motion: no-preference) {
    .amesho, .avg { transform-origin: 0 0; }
    .radar.armed:not(.in) :is(.amesho, .avg) { transform: scale(0); }
    .radar.armed:not(.in) :is(.dot, .boom) { opacity: 0; }
    .radar.in .avg { animation: grow-avg .5s ease-out both; }
    .radar.in .amesho { animation: grow 1.5s cubic-bezier(.3, 1.5, .5, 1) .35s both; }
    .radar.in .dot { animation: dot-out 1.5s cubic-bezier(.3, 1.5, .5, 1) .35s both; }
    .radar.in .boom { transform-box: fill-box; transform-origin: 50% 50%; animation: stamp .5s cubic-bezier(.3, 1.8, .5, 1) 1.5s both, shake 2.6s ease-in-out 2.2s infinite; }
    @keyframes grow-avg { from { transform: scale(0); } to { transform: scale(1); } }
    /* 一度枠内で止まりかけてから、枠を突き破って伸びる */
    @keyframes grow { 0% { transform: scale(0); } 35% { transform: scale(.52); } 48% { transform: scale(.55); } 100% { transform: scale(1); } }
    @keyframes dot-out { 0% { translate: calc(var(--x) * -1) calc(var(--y) * -1); opacity: 0; } 10% { opacity: 1; } 35% { translate: calc(var(--x) * -.48) calc(var(--y) * -.48); } 48% { translate: calc(var(--x) * -.45) calc(var(--y) * -.45); } 100% { translate: 0 0; opacity: 1; } }
    @keyframes stamp { from { opacity: 0; scale: 2.4; rotate: -14deg; } to { opacity: 1; scale: 1; rotate: -4deg; } }
    @keyframes shake { 0%, 84%, 100% { rotate: -4deg; } 88% { rotate: 6deg; } 92% { rotate: -8deg; } 96% { rotate: 3deg; } }
  }
</style>

<script>
  // 画面に入ったタイミングで .in を付けてアニメーションを開始する
  for (const fig of document.querySelectorAll<HTMLElement>('.radar')) {
    if (!('IntersectionObserver' in window)) break;
    fig.classList.add('armed');
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { fig.classList.add('in'); io.disconnect(); }
    }, { threshold: 0.45 });
    io.observe(fig);
  }
</script>
