---
import '../styles/global.css';
import { faceSvg } from '../data/pop-art';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const d = new Date(Date.now() + 9 * 3600 * 1000); // 日本時間のビルド日
const issueDate = `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
const nav = [
  { href: '#verdict', label: '結論' },
  { href: '#evidence', label: '証拠' },
  { href: '#meter', label: '計測' },
  { href: '#rumors', label: 'ウワサ検証' },
  { href: '#wanted', label: '指名手配' },
  { href: '#serious', label: '真面目な話' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="週刊ラグドール" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#aeb6c4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=DotGothic16&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap" />
  </head>
  <body>
    <div class="hair" aria-hidden="true">
      <svg viewBox="0 0 1200 176" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 0 H1200 V150 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 L618 44 Q600 22 582 44 L500 150 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 q-12 22 -25 0 Z" fill="#aeb6c4" stroke="#141414" stroke-width="4" vector-effect="non-scaling-stroke"/>
        <path d="M150 20 q10 40 -4 80 M300 10 q12 50 -2 100 M420 30 q8 40 -6 70 M780 30 q-8 40 6 70 M900 10 q-12 50 2 100 M1050 20 q-10 40 4 80" fill="none" stroke="#7f8898" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a href={base} class="brand" aria-label="週刊ラグドール トップへ">
          <span class="logo-face" set:html={faceSvg('seal', 'bicolor', 'normal')} />
          <span><b>週刊ラグドール</b><small>ラグドールは可愛いのか？ 特別号</small></span>
        </a>
        <p class="issue">{issueDate}発行 第1号<span class="price">定価:のびしろ</span></p>
      </div>
      <nav class="wrap nav" aria-label="ページ内の記事">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </header>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        <span><b>速報</b>ラグドール、また伸びる</span>
        <span><b>続報</b>子ラグ、母の背中を占拠</span>
        <span><b>独自</b>青い目、やっぱり青かった</span>
        <span><b>速報</b>夜中の大運動会、今夜も開催の見通し</span>
        <span><b>号外</b>「可愛いのか？」の答え、まだ出ず</span>
      </div>
    </div>
    <main class="wrap">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p><b>週刊ラグドール</b> 〜ラグドールは可愛いのか？〜</p>
        <p>ラグドールは可愛いのか。取材班が全力で(そして少しだけ真面目に)検証するサイトです。</p>
        <p>性格や体の特徴には個体差があります。健康について気になることがあるときは、動物病院にご相談ください。</p>
        <p>© {new Date().getFullYear()} 週刊ラグドール</p>
      </div>
    </footer>
  </body>
</html>
