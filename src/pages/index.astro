---
import Base from '../layouts/Base.astro';
import ColumnList from '../components/ColumnList.astro';
import { getColumns } from '../lib';
import { familySvg, faceSvg, bodySvg, COAT, PATTERN_LABEL, OVERLAY_LABEL, type Coat, type Pattern, type Overlay } from '../data/pop-art';

const latest = (await getColumns()).slice(0, 6);

// 事実として書くのは、品種の基準・体のつくり・報告のある病気など確かなことだけ。
// 性格は「よく言われる」と「実際は」を分けて書く(横田さんの指摘:「おだやか・のんびり」は大嘘)。
const evidence = [
  { t: '目が、青しかない', tag: '公式設定', d: 'ラグドールの目の色は、品種の基準でブルーだけ。全員カラコン入れてるみたいな顔で、真顔でこっちを見てくる。' },
  { t: '生まれたときは真っ白', tag: 'あとから塗る', d: '体の冷えやすいところに色が出るタイプの毛色なので、子猫は白っぽく生まれて、顔・耳・しっぽ・足にあとから色がつく。ぬりえ方式。' },
  { t: 'でかい', tag: '重い', d: '大型の猫種で、オスは6〜9kgほどになる子もいる(目安)。5kgのお米より重いこともある。寝そべると「えっ、まだ続くの?」ってくらい長い。' },
  { t: '完成まで3〜4年', tag: '長期連載', d: '体が大人になるまで3〜4年ほどかかるといわれる。「まだ成長期なんで」と言い張れる期間がやたら長い。' },
  { t: '首まわりがライオン気取り', tag: 'もふ', d: 'セミロングの毛で、首まわりの飾り毛(ラフ)がたてがみみたいにふっさふさ。しっぽもふさふさ。本人はたぶん何も考えてない。' },
  { t: '名前が「ぬいぐるみ」', tag: '名前負け注意', d: 'ラグドール=英語で「ぬいぐるみ」。抱き上げると力が抜ける子がいるのが名前の由来といわれる。※ただし名前負けしてる子も普通にいる(下のウワサ検証へ)。' },
];

type Judge = 'kotai' | 'usoyori' | 'uso' | 'hontou';
const JUDGE: Record<Judge, string> = { kotai: '判定:個体差!!', usoyori: '判定:ウソ寄り', uso: '判定:ウソ', hontou: '判定:わりとホント' };
const rumors: { q: string; j: Judge; a: string }[] = [
  { q: '「おとなしくて、のんびりした猫」', j: 'kotai', a: 'よく紹介文に書いてあるけど、子猫〜若いうちは家じゅうを全力疾走する子も普通にいる。夜中の大運動会も開催される。「おとなしい猫種」と思って迎えると、たぶん驚く。落ち着き方は、子によっても年齢によってもぜんぜん違う。' },
  { q: '「抱っこすると必ずだら〜んとなる」', j: 'kotai', a: '力が抜けてとろける子もいれば、抱っこはきらい、という子もいる。名前の由来になった性質だけど、全ラグドール共通の仕様ではない。' },
  { q: '「ほとんど鳴かない、静か」', j: 'usoyori', a: 'よくしゃべる子もいる。鳴く回数も声の大きさも子それぞれ。「静かな猫がいい」という理由だけで選ぶのはおすすめしない。' },
  { q: '「痛みを感じにくい」', j: 'uso', a: '完全にウソ。ラグドールにも、ほかの猫と同じようにちゃんと痛覚がある。昔から出回っている根拠のない話。猫は具合が悪くても痛がるそぶりを見せずにがまんしがちなので、「痛がらない=痛くない」ではない。いつもと違う様子に気づいてあげて。' },
  { q: '「毛玉ができにくい」', j: 'usoyori', a: 'できにくい毛質といわれることもあるけど、セミロングなので、わきの下・おなか・耳のうしろはからまりやすい。ブラッシングはサボらないほうがいい。' },
  { q: '「人のそばにいたがる」', j: 'hontou', a: '人と一緒にいるのが好きな子が多いといわれ、家の中でついて回る子もいる。※ただしこれも子による。ひとりの時間が好きな子もいる。' },
];

// 毛色・がらの情報は、CFA・TICA・FIFe・GCCF・WCF の公式ブリード標準(2025〜2026年版)で確認した内容。
const coats: { c: Coat; crime: string; d: string }[] = [
  { c: 'seal', crime: '王道ヅラの罪', d: 'ポイントは濃いこげ茶(黒ではない)。体は淡い黄褐色〜クリーム。いちばんよく見かける色。' },
  { c: 'chocolate', crime: '食べられない罪', d: 'ポイントはミルクチョコのような明るい茶色。体はアイボリー。' },
  { c: 'red', crime: 'オレンジなのにレッドを名乗る罪', d: 'ポイントは明るいアプリコット〜濃い赤。体は白〜クリームがかった白。うっすらしまや、そばかすが出てもOK。団体によっては「フレーム」とも呼ぶ。' },
  { c: 'blue', crime: 'どう見てもグレーなのにブルーを名乗る罪', d: 'ポイントは青みがかったグレー。体は冷たい感じの青白い白。シールの色が薄まった版(ダイリュート)。' },
  { c: 'lilac', crime: '色の説明がむずかしい罪', d: 'ポイントはピンクがかった霜のようなグレー。体はほぼ真っ白。チョコの色が薄まった版。' },
  { c: 'cream', crime: 'ほぼ白で存在感を消す罪', d: 'ポイントは淡いクリーム〜ピンクがかったクリーム。体は白っぽい。レッドの色が薄まった版。' },
];
const patterns: { p: Pattern; crime: string; d: string; note?: string }[] = [
  { p: 'colorpoint', crime: '白をどこかに置いてきた罪', d: '顔・耳・足・しっぽがポイントカラーで、白い部分がない。鼻と肉球もポイントと同じ色。' },
  { p: 'mitted', crime: '手ぶくろで証拠を残さない罪', d: '前足に白いミトン、後ろ足はかかとまわりまで白いブーツ。あごは白で、胸からおなかに白いすじが通る。鼻すじに白い模様(ブレーズ)が入る子も。' },
  { p: 'bicolor', crime: '顔に逆V字を書いてくる罪', d: '顔に白い逆V字(目の外側からはみ出さない)。あご・胸・おなか・4本の足が白。色があるのは耳・マスク・しっぽと、背中の「サドル」。' },
  { p: 'van', crime: 'ほぼ白で出頭してくる罪', d: '色があるのは耳・しっぽ・顔の上のほうだけ。体と足はほぼ真っ白。', note: '※バンを認めているのはCFAだけ' },
];
const overlays: { o: Overlay; c: Coat; crime: string; d: string }[] = [
  { o: 'lynx', c: 'seal', crime: '顔にMを書いてくる罪', d: 'ポイントがしま模様になったもの(タビーポイント)。額にM字、目のまわりにメガネ模様、足としっぽにしま、耳のうしろに薄い「指紋」。6色すべてにある。' },
  { o: 'tortie', c: 'seal', crime: '色を混ぜすぎた罪', d: 'ポイントにレッドやクリームがまだらに混ざる。シール・チョコ・ブルー・ライラックの4色だけ(ブルーとライラックは「ブルークリーム」「ライラッククリーム」とも)。三毛猫と同じしくみなので、ほとんどがメス。' },
  { o: 'torbie', c: 'seal', crime: '両方やる罪', d: 'トーティ+リンクス(トーティリンクス)。見た目はリンクス寄りになりやすい。' },
];
type Mark = 'o' | 'x' | 'other';
const REGISTRIES = ['CFA', 'TICA', 'FIFe', 'GCCF', 'WCF'];
const registryRows: { k: string; v: Mark[]; note?: string }[] = [
  { k: 'シール・チョコ・レッド・ブルー・ライラック・クリーム', v: ['o', 'o', 'o', 'o', 'o'] },
  { k: 'リンクス・トーティ・トービー', v: ['o', 'o', 'o', 'o', 'o'] },
  { k: 'カラーポイント・ミテッド・バイカラー', v: ['o', 'o', 'o', 'o', 'o'] },
  { k: 'バン', v: ['o', 'x', 'x', 'x', 'x'] },
  { k: 'ミンク・セピア・ソリッド(目が青くない)', v: ['x', 'other', 'x', 'x', 'x'], note: 'TICAでは「チェルビム」という別の猫種' },
];
const MARK: Record<Mark, string> = { o: '○', x: '×', other: '別品種' };
const stages = [
  { fade: 0.08, t: '生まれたて', d: 'ほぼ真っ白。ここから色がつく。' },
  { fade: 0.35, t: '生後数日〜数週間', d: '耳・鼻・しっぽのあたりから、じわじわ色が出てくる。' },
  { fade: 0.7, t: '1歳ごろ', d: 'だいぶそれっぽい。でもまだ途中。' },
  { fade: 1, t: '2〜3歳ごろ', d: 'ポイントの色がほぼ完成(団体によって「2年」「3年」)。体が大人になるのは3〜4年ほど。年をとると体の色が濃くなることも。' },
];
---
<Base title="ラグドールは可愛いのか？|週刊ラグドール 特別号" description="【号外】ラグドールは可愛いのか？取材班が測ったら、思ったより長かった。青い目、でかい体、夜中の大運動会。よく言われるウワサの真偽と、毛色・がらの指名手配、迎える前の真面目な話も。">
  <section class="front" aria-labelledby="front-h">
    <span class="gogai" aria-hidden="true">号外</span>
    <div class="front-copy">
      <span class="kicker">緊急検証</span>
      <h1 id="front-h">ラグドールは<br />可愛いのか<span class="q">？</span></h1>
      <p class="sub-head">取材班、測ってみたら<span class="hl">思ったより長かった</span></p>
      <p>青い目。でかい体。寝そべると、どこまでも伸びる。「ぬいぐるみ」という名前のくせに、夜中に全力で走る。こいつは本当に可愛いのか。それとも、ただ面白いだけなのか。取材班は、寝そべる親子に密着した。……母、まだ伸びている。</p>
      <div class="cta">
        <a class="btn btn-pink" href="#verdict">結論を先に見る</a>
        <a class="btn" href="#rumors">ウワサを疑う</a>
      </div>
    </div>
    <div class="front-art">
      <span class="onomatopoeia ono-1" aria-hidden="true">でーん</span>
      <span class="onomatopoeia ono-2" aria-hidden="true">のび〜</span>
      <div class="family-wrap" set:html={familySvg()} />
    </div>
  </section>

  <section class="verdict" id="verdict" aria-labelledby="verdict-h">
    <span class="stamp" aria-hidden="true">検証終了</span>
    <div>
      <span class="label">■ 取材班の結論</span>
      <h2 id="verdict-h">可愛いかは知らん。<em>長い。</em></h2>
      <p>調べれば調べるほど、「可愛い」より先に「なんで?」が来る猫だった。おとなしいと聞いていたのに走る。ぬいぐるみと聞いていたのに重い。目が青い。でも気づいたら目で追っている。それを可愛いと呼ぶかどうかは、あなた次第です。ちなみに取材班は、取材中に気づいたらメインクーンとサイベリアンの動画まで見ていた。長毛にハマるとだいたいこうなる。</p>
    </div>
    <div class="face" set:html={faceSvg('seal', 'bicolor', 'smug', '真顔でこっちを見るラグドール', true)} />
  </section>

  <div class="band" id="columns"><span class="no">NEW</span><h2>最新の検証コラム</h2></div>
  <ColumnList items={latest} />
  <p class="more"><a class="btn" href="/columns/">コラムをもっと読む</a></p>

  <div class="band" id="evidence"><span class="no">01</span><h2>ツッコミどころ、6点</h2></div>
  <p class="lede">まずは確かなことだけ。品種としての特徴です。全部ほんとう。</p>
  <div class="evidence">
    {evidence.map((e) => (
      <article class="ev">
        <span class="tag">{e.tag}</span>
        <h3>{e.t}</h3>
        <p>{e.d}</p>
      </article>
    ))}
  </div>

  <div class="band" id="meter"><span class="no">02</span><h2>のび、計ってみた</h2></div>
  <p class="lede">母ラグが寝そべったときの「のび」を、専用メーターで計測しました。</p>
  <div class="meter-box">
    <svg class="gauge" viewBox="0 0 400 240" role="img" aria-label="のびメーター。針が振り切れて計測不能">
      <path d="M40 200 A160 160 0 0 1 360 200" fill="none" stroke="#141414" stroke-width="34" />
      <path d="M40 200 A160 160 0 0 1 200 40" fill="none" stroke="#e3efff" stroke-width="26" />
      <path d="M200 40 A160 160 0 0 1 313 87" fill="none" stroke="#aeb6c4" stroke-width="26" />
      <path d="M313 87 A160 160 0 0 1 360 200" fill="none" stroke="#3d8cf0" stroke-width="26" />
      <g font-family="DotGothic16, monospace" font-size="15" fill="#141414" text-anchor="middle">
        <text x="40" y="232">ねこ</text><text x="200" y="20">長め</text><text x="360" y="232">長すぎ</text>
      </g>
      <g class="needle"><path d="M196 200 L200 58 L204 200 Z" fill="#141414" /><circle cx="200" cy="200" r="14" fill="#141414" /><circle cx="200" cy="200" r="5" fill="#3d8cf0" /></g>
      <g class="crack" opacity="0"><path d="M352 150 l18 -10 l-6 16 l20 -4 l-14 14 l16 8" fill="none" stroke="#141414" stroke-width="3" stroke-linejoin="round" /></g>
    </svg>
    <div class="gauge-read" aria-live="polite">
      計測結果
      <strong id="gauge-num">0</strong>
      <span id="gauge-note">計測中…</span>
    </div>
  </div>

  <div class="band" id="rumors"><span class="no">03</span><h2>よく聞くウワサ、検証します</h2></div>
  <p class="lede">ラグドールの紹介でよく見る決まり文句。そのまま信じると、だいたい裏切られます。</p>
  <div class="rumors">
    {rumors.map((r) => (
      <article class="rumor">
        <div class="rumor-q"><small>ウワサ</small><h3>{r.q}</h3></div>
        <div class="rumor-a"><span class={`judge judge-${r.j}`}>{JUDGE[r.j]}</span><p>{r.a}</p></div>
      </article>
    ))}
  </div>

  <div class="band" id="wanted"><span class="no">04</span><h2>指名手配:毛色の容疑者、全員集合</h2></div>
  <p class="lede">ラグドールの見た目は「ポイントの色」×「白の入り方(がら)」×「模様」の組み合わせ。主要な猫の登録団体(CFA・TICA・FIFe・GCCF・WCF)は、どこもポイントの色を同じ6色で認めています。</p>

  <span class="sub-band">色:6色</span>
  <div class="wanted-grid">
    {coats.map((x) => (
      <article class="wanted">
        <div class="w-title">WANTED</div>
        <div class="w-sub">でかすぎる容疑</div>
        <div class="w-pic" set:html={bodySvg(x.c, 'colorpoint', 'solid', `${COAT[x.c].label}ポイントのラグドール`)} />
        <h3>{COAT[x.c].label}</h3>
        <span class="crime">罪状:{x.crime}</span>
        <p>{x.d}</p>
      </article>
    ))}
  </div>

  <span class="sub-band">がら:4種</span>
  <div class="wanted-grid four">
    {patterns.map((x) => (
      <article class="wanted">
        <div class="w-title">WANTED</div>
        <div class="w-sub">でかすぎる容疑</div>
        <div class="w-pic" set:html={bodySvg('seal', x.p, 'solid', `シール${PATTERN_LABEL[x.p]}のラグドール`)} />
        <h3>{PATTERN_LABEL[x.p]}</h3>
        <span class="crime">罪状:{x.crime}</span>
        <p>{x.d}</p>
        {x.note && <p class="w-note">{x.note}</p>}
      </article>
    ))}
  </div>

  <span class="sub-band">模様:3種</span>
  <div class="wanted-grid three">
    {overlays.map((x) => (
      <article class="wanted">
        <div class="w-title">WANTED</div>
        <div class="w-sub">でかすぎる容疑</div>
        <div class="w-pic" set:html={bodySvg(x.c, 'colorpoint', x.o, `シール${OVERLAY_LABEL[x.o]}のラグドール`)} />
        <h3>{OVERLAY_LABEL[x.o]}</h3>
        <span class="crime">罪状:{x.crime}</span>
        <p>{x.d}</p>
      </article>
    ))}
  </div>

  <span class="sub-band">別件</span>
  <article class="wanted wanted-wide">
    <div class="w-pic" set:html={faceSvg('mink', 'mitted', 'normal', '目が青緑のミンクの猫')} />
    <div>
      <div class="w-title">ミンク・セピア・ソリッド</div>
      <span class="crime">罪状:ラグドールを名乗る罪(目が青くない)</span>
      <p>体の色が濃いめで、目がアクア(青緑)・金・緑などになる猫たち。ラグドールは品種の基準で目が青いことが必須なので、CFA・FIFe・GCCF・WCFはどこもラグドールとして認めていません。TICAでは2025年5月から、ミンク・セピア・ソリッドを「チェルビム(Cherubim)」という別の猫種として扱っています。「ラグドール」として紹介されていたら、どの団体の基準なのか確認を。</p>
    </div>
  </article>

  <span class="sub-band">組み合わせ</span>
  <div class="gacha">
    <div class="gacha-pic" id="gacha-pic" set:html={bodySvg('blue', 'bicolor', 'lynx', 'ブルーリンクスバイカラーのラグドール')} />
    <div class="gacha-body">
      <p class="gacha-count">ざっくり数えて<strong>60通り</strong><small>(6色×がら3種×模様。CFAだけのバンまで入れると80通り)</small></p>
      <p class="gacha-name" id="gacha-name" aria-live="polite">ブルー・リンクス・バイカラー</p>
      <button class="btn btn-pink" type="button" id="gacha-btn">ラグドールガチャを回す</button>
      <p class="small">※当サイト調べ(色×白の入り方×模様の単純な掛け算)。</p>
    </div>
  </div>

  <div class="band"><span class="no">05</span><h2>生まれたときは、ほぼ白</h2></div>
  <p class="lede">ポイントカラーの猫は、体の冷えやすいところに色が出るしくみ。ラグドールは白っぽく生まれて、年単位で完成していきます。</p>
  <ol class="stages">
    {stages.map((x) => (
      <li class="stage">
        <div class="stage-pic" set:html={faceSvg('seal', 'bicolor', 'normal', undefined, false, 'solid', x.fade)} />
        <b>{x.t}</b>
        <p>{x.d}</p>
      </li>
    ))}
  </ol>

  <div class="band"><span class="no">06</span><h2>団体ごとの認定、比べてみた</h2></div>
  <div class="reg-wrap">
    <table class="reg">
      <thead><tr><th scope="col">色・がら</th>{REGISTRIES.map((r) => <th scope="col">{r}</th>)}</tr></thead>
      <tbody>
        {registryRows.map((r) => (
          <tr>
            <th scope="row">{r.k}{r.note && <small>{r.note}</small>}</th>
            {r.v.map((m) => <td class={`m-${m}`}>{MARK[m]}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="wanted-note">※各団体の公式ブリード標準(2025〜2026年版)をもとに当サイトで確認。目の色はどの団体もブルー必須です。</p>

  <div class="band" id="serious"><span class="no">07</span><h2>ここだけ真面目な話</h2></div>
  <div class="serious">
    <p class="serious-head"><span>迎える前に</span>可愛いだけで終わらせないために</p>
    <dl>
      <dt>心臓の病気(肥大型心筋症)</dt>
      <dd>ラグドールでは、この病気に関わる遺伝子の変異が見つかっていて、遺伝子検査もあります。迎えるときは、ブリーダーに親猫の検査のことを聞いてみてください。検査で問題がなくても発症しないとは限らないので、定期的な健康診断で心臓も診てもらうと安心です。</dd>
      <dt>大きな体に合った道具</dt>
      <dd>大人になると体が大きく重くなる子も多いので、キャットタワーやキャリー、トイレは大きめ・丈夫なものを。</dd>
      <dt>運動会の会場づくり</dt>
      <dd>若いうちは全力で遊ぶ子も多いです。遊ぶ時間をつくって、走り回っても危なくない部屋にしておくと、夜中の大運動会も平和に終わります。</dd>
      <dt>ブラッシングと体重管理</dt>
      <dd>セミロングなので、からまりやすい場所を中心に週に数回〜毎日のブラッシングを(目安)。大きな体で太ると関節などの負担になるので、体重もときどき測ってあげてください。</dd>
    </dl>
    <p class="small">※一般的な情報です。個体差があります。健康のことは、かかりつけの獣医師に相談してください。</p>
  </div>

  <section class="poll" aria-labelledby="poll-h">
    <div class="face" set:html={faceSvg('blue', 'mitted', 'wow', '目を見開いたラグドール', true)} />
    <div>
      <h2 id="poll-h">読者アンケート:結局、ラグドールとは？</h2>
      <p>いちばん近いのを押してください。何回押してもいいです。</p>
      <div class="cta">
        <button class="btn btn-pink vote" type="button" data-k="a">可愛い</button>
        <button class="btn btn-blue vote" type="button" data-k="b">長い</button>
        <button class="btn vote" type="button" data-k="c">重い</button>
      </div>
      <div class="poll-result" aria-live="polite">
        <div>可愛い<div class="bar"><i data-bar="a"></i><span data-n="a">0</span></div></div>
        <div>長い<div class="bar"><i data-bar="b"></i><span data-n="b">0</span></div></div>
        <div>重い<div class="bar"><i data-bar="c"></i><span data-n="c">0</span></div></div>
        <small>※この端末で押した回数です。どれを押しても、結局みんな猫が好き。</small>
      </div>
    </div>
  </section>

  <button class="peek" type="button" aria-label="のぞいているラグドール">
    <span class="say">見た？</span>
    <Fragment set:html={faceSvg('lilac', 'bicolor', 'normal', undefined, true)} />
  </button>

  <script>
    import { bodySvg, canTortie, COAT, PATTERN_LABEL, OVERLAY_LABEL, type Coat, type Pattern, type Overlay } from '../data/pop-art';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    // かわいさメーター:見えたら針が振り切れて、数字が暴走して「計測不能」
    const gauge = document.querySelector<SVGSVGElement>('.gauge');
    const num = document.getElementById('gauge-num');
    const note = document.getElementById('gauge-note');
    if (gauge && num && note) {
      const needle = gauge.querySelector<SVGGElement>('.needle')!;
      const crack = gauge.querySelector<SVGGElement>('.crack')!;
      const finish = () => { needle.style.rotate = '96deg'; crack.setAttribute('opacity', '1'); num.textContent = '計測不能'; note.textContent = 'まだ伸びています'; };
      if (reduce || !('IntersectionObserver' in window)) finish();
      else {
        const io = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          needle.animate(
            [{ rotate: '-90deg' }, { rotate: '-10deg', offset: .35 }, { rotate: '-20deg', offset: .45 }, { rotate: '70deg', offset: .75 }, { rotate: '100deg', offset: .88 }, { rotate: '92deg', offset: .94 }, { rotate: '96deg' }],
            { duration: 2200, easing: 'ease-out', fill: 'forwards' },
          );
          const t0 = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / 2000);
            num.textContent = String(Math.floor(Math.pow(p, 3) * 99999));
            if (p < 1) requestAnimationFrame(tick);
            else { finish(); gauge.animate([{ translate: '0 0' }, { translate: '-6px 0' }, { translate: '6px 0' }, { translate: '-3px 0' }, { translate: '0 0' }], { duration: 300 }); }
          };
          requestAnimationFrame(tick);
        }, { threshold: .6 });
        io.observe(gauge);
      }
    }

    // 読者アンケート(この端末だけに保存)と、押すと言葉が飛ぶ演出
    const counts: Record<string, number> = { a: 0, b: 0, c: 0 };
    try { Object.assign(counts, JSON.parse(localStorage.getItem('rag-poll') ?? '{}')); } catch {}
    const render = () => {
      const max = Math.max(1, ...Object.values(counts));
      for (const k of Object.keys(counts)) {
        const bar = document.querySelector<HTMLElement>(`[data-bar="${k}"]`);
        const n = document.querySelector<HTMLElement>(`[data-n="${k}"]`);
        if (bar) bar.style.width = `${(counts[k] / max) * 100}%`;
        if (n) n.textContent = String(counts[k]);
      }
    };
    render();
    const WORDS = ['のびる', 'でかい', '青い…', 'なんで？', '重っ', 'かわ…いい？'];
    for (const b of document.querySelectorAll<HTMLButtonElement>('.vote')) {
      b.addEventListener('click', () => {
        const k = b.dataset.k!;
        counts[k]++;
        try { localStorage.setItem('rag-poll', JSON.stringify(counts)); } catch {}
        render();
        if (reduce) return;
        const r = b.getBoundingClientRect();
        for (let i = 0; i < 4; i++) {
          const w = document.createElement('span');
          w.className = 'pop-word';
          w.textContent = WORDS[Math.floor(Math.random() * WORDS.length)];
          w.style.left = `${r.left + scrollX + r.width / 2 - 30}px`;
          w.style.top = `${r.top + scrollY - 10}px`;
          w.style.setProperty('--dx', `${rand(-140, 140)}px`);
          w.style.setProperty('--dy', `${rand(-150, -60)}px`);
          w.style.setProperty('--r', `${rand(-25, 25)}deg`);
          w.style.animationDelay = `${i * 60}ms`;
          document.body.appendChild(w);
          w.addEventListener('animationend', () => w.remove());
        }
      });
    }

    // ラグドールガチャ:色×がら×模様をランダムに組み合わせて描く
    const gBtn = document.getElementById('gacha-btn');
    const gPic = document.getElementById('gacha-pic');
    const gName = document.getElementById('gacha-name');
    if (gBtn && gPic && gName) {
      const COATS: Coat[] = ['seal', 'chocolate', 'red', 'blue', 'lilac', 'cream'];
      const PATS: Pattern[] = ['colorpoint', 'mitted', 'bicolor'];
      const pick = <T,>(a: T[]) => a[Math.floor(Math.random() * a.length)];
      gBtn.addEventListener('click', () => {
        const c = pick(COATS);
        const p = pick(PATS);
        const o: Overlay = pick(canTortie(c) ? ['solid', 'lynx', 'tortie', 'torbie'] : ['solid', 'lynx']);
        const name = [c === 'blue' && o === 'tortie' ? 'ブルークリーム' : c === 'lilac' && o === 'tortie' ? 'ライラッククリーム' : COAT[c].label + (OVERLAY_LABEL[o] ? '・' + OVERLAY_LABEL[o] : ''), PATTERN_LABEL[p]].join('・');
        gPic.innerHTML = bodySvg(c, p, o, `${name}のラグドール`);
        gName.textContent = name;
        if (!reduce) gPic.animate([{ scale: '.6', rotate: '-12deg', opacity: 0 }, { scale: '1.08', rotate: '4deg', opacity: 1, offset: .6 }, { scale: '1', rotate: '0deg' }], { duration: 450, easing: 'ease-out' });
      });
    }

    // 画面の右下からのぞくラグドール(一面を過ぎたら出てくる。押すとしゃべる)
    const peek = document.querySelector<HTMLButtonElement>('.peek');
    const front = document.querySelector('.front');
    if (peek && front) {
      const LINES = ['見た？', 'のびるよ', '運動会は今夜です', 'ぬいぐるみではない', '目、青いでしょ'];
      new IntersectionObserver(([e]) => peek.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(front);
      let timer = 0;
      peek.addEventListener('click', () => {
        peek.querySelector('.say')!.textContent = LINES[Math.floor(Math.random() * LINES.length)];
        peek.classList.add('talk');
        clearTimeout(timer);
        timer = window.setTimeout(() => peek.classList.remove('talk'), 1800);
      });
    }
  </script>
</Base>
